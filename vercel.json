{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "node_modules/sqlite3/**"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/story", "destination": "/index.html" }
  ]
}
